            "example": { "id": "a4ybMBANAg41W7hFs-o6xA", "status": "done", "total": 16, "done": 16, "rows": [ { "name": "Stripe", "domain": "stripe.com", "critical": true, "status": "ok", "host": "api.stripe.com", "hosting": "Amazon Web Services", "hostingCategory": "cloud", "region": null, "country": "US", "confidence": "high", "cdn": null, "originHidden": false, "dns": "AWS Route 53", "email": "Google Workspace", "certIssuer": "DigiCert", "certNotAfter": "2026-12-10T23:59:59.000Z" } ], "summary": { "vendors": 16, "critical": 8, "hiddenOrigins": 1, "distinctHosting": 3 }, "expiresAt": "2026-11-12T14:46:40.175Z" } } } },
