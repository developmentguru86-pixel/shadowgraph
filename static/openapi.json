    "/_api/machine/intelligence": {
      "post": {
        "tags": ["Machine intelligence (paid)"],
        "operationId": "purchaseIntelligence",
        "summary": "Buy one intelligence result",
        "description": "Modes: hidden_chain $0.50, alpha $0.75, opportunity $1.00, global_brief $2.50, deep_research $5.00. The first request returns 402 with WWW-Authenticate: Payment (method stripe, intent charge, request = base64url JSON with amount in cents). Retry the identical request with Authorization: Payment <credential>. A failed payment returns a new challenge. Results are probabilistic intelligence; inferred edges and statistical lead/lag are hypotheses, not proof.",
        "security": [ { "mpp": [] } ],
        "x-payment-info": { "price": { "mode": "dynamic", "currency": "USD", "min": "0.50", "max": "5.00" }, "protocols": [ { "mpp": { "method": "stripe", "intent": "charge", "currency": "usd" } } ] },
        "requestBody": { "required": true, "content": { "application/json": {
          "schema": { "type": "object", "required": ["mode"], "additionalProperties": false, "properties": { "mode": { "type": "string", "enum": ["hidden_chain", "alpha", "opportunity", "global_brief", "deep_research"], "default": "hidden_chain" } } },
          "example": { "mode": "hidden_chain" }
        } } },
        "responses": {
          "200": { "description": "Paid result.", "headers": { "Payment-Receipt": { "schema": { "type": "string" }, "description": "Base64url-encoded MPP receipt." } }, "content": { "application/json": { "schema": { "type": "object", "required": ["requestId", "priceUsd", "intelligence"], "properties": { "requestId": { "type": "string" }, "priceUsd": { "type": "number" }, "intelligence": { "type": "object" } } } } } },
          "402": { "description": "Payment required.", "headers": { "WWW-Authenticate": { "schema": { "type": "string" }, "description": "Payment id=\"…\", realm=\"…\", method=\"stripe\", intent=\"charge\", request=\"…\", description=\"…\", expires=\"…\"" } }, "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/PaymentProblem" } } } }
        }
      }
    },
