        "responses": { "200": { "description": "Agent layer.", "content": { "application/json": { "schema": { "type": "object", "properties": { "hubs": { "type": "array", "items": { "type": "object" } }, "signals": { "type": "array", "items": { "type": "object" } }, "feed": { "type": "array", "items": { "type": "object" } }, "probe": { "type": ["object", "null"] }, "totals": { "type": "object" } } } } } } }
      }
    },
    "/_api/mcp": {
      "post": {
        "tags": ["AI agents"],
        "operationId": "mcp",
        "summary": "MCP server (Streamable HTTP)",
        "description": "JSON-RPC 2.0 MCP endpoint, protocol versions 2026-07-28 and 2025-11-25. Free tools: shadowgraph_market_recap, shadowgraph_company_filings, shadowgraph_eu_tenders, shadowgraph_free_preview, shadowgraph_service_info. Paid tools ($0.50–$5.00) use the MPP MCP binding: an unpaid tools/call returns JSON-RPC error -32042 with error.data.challenges; retry with params._meta[\"org.paymentauth/credential\"]; the receipt is returned in result._meta[\"org.paymentauth/receipt\"]. For 2026-07-28 send MCP-Protocol-Version, Mcp-Method and (for tools/call) Mcp-Name headers.",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["jsonrpc", "method"], "properties": { "jsonrpc": { "const": "2.0" }, "id": { "type": ["string", "integer"] }, "method": { "type": "string" }, "params": { "type": "object" } } }, "example": { "jsonrpc": "2.0", "id": 1, "method": "tools/list" } } } },
        "responses": { "200": { "description": "JSON-RPC response or error." } }
      }
    },
    "/_api/a2a": {
      "post": {
        "tags": ["AI agents"],
        "operationId": "a2a",
        "summary": "A2A agent (JSON-RPC, v1.0)",
