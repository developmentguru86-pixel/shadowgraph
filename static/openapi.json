    "/_api/global_markets": { "get": { "tags": ["Markets & official data"], "operationId": "getMarkets", "summary": "Market data", "description": "Price, 1-day and 5-day change and volume ratio for a global watchlist. Cached 2 minutes.", "responses": { "200": { "description": "Quotes.", "content": { "application/json": { "schema": { "type": "object" } } } } } } },
